#
# Yearn data sources
#
# Envio HyperIndex indexer used for depositor fee calculations (supports multi-chain)
ENVIO_GRAPHQL_URL=""
# Optional Bearer token for an authenticated Envio endpoint
ENVIO_PASSWORD=""
# Optional: Kong GraphQL endpoint used for vault metadata (reduces RPC calls)
KONG_GRAPHQL_URL="https://kong.yearn.fi/api/gql"

#
# RPC configuration (chain-specific)
# Prefer *_PUBLIC for latest reads and *_PRIVATE for archive reads.
# If *_PUBLIC/_PRIVATE are unset, RPC_URL_* is used. If still unset, public fallbacks are used.
#
RPC_URL_MAINNET_PUBLIC=""
RPC_URL_MAINNET=""
RPC_URL_BASE_PUBLIC=""
RPC_URL_BASE_PRIVATE=""
RPC_URL_BASE=""
RPC_URL_ARBITRUM_PUBLIC=""
RPC_URL_ARBITRUM_PRIVATE=""
RPC_URL_ARBITRUM=""
RPC_URL_POLYGON_PUBLIC=""
RPC_URL_POLYGON_PRIVATE=""
RPC_URL_POLYGON=""
RPC_URL_KATANA_PUBLIC=""
RPC_URL_KATANA_PRIVATE=""
RPC_URL_KATANA=""

#
# Contact form (Telegram)
#
TELEGRAM_BOT=""
TELEGRAM_RECIPIENT_USERID=""
# Optional: comma-separated list of IPs to block from the contact form
IP_TO_BLOCK=""

# Optional: Redis URL for rate limiting (e.g. Upstash)
REDIS_URL=""

# Optional: Cloudflare Turnstile for contact form CAPTCHA. Configure both values
# together; when the secret is set, every submission must carry a valid token.
CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET=""
