#
# Yearn data sources
#
YVISION_BASE_URI="https://yvision.yearn.fi"
# Envio indexer used for depositor fee calculations
ENVIO_GRAPHQL_URL=""
# Optional: Kong GraphQL endpoint used for vault metadata (reduces RPC calls)
KONG_GRAPHQL_URL="https://kong.yearn.fi/api/gql"

#
# RPC configuration (chain-specific)
# Prefer *_PUBLIC for latest reads and *_PRIVATE for archive reads.
# If *_PUBLIC/_PRIVATE are unset, RPC_URL_* is used. If still unset, public fallbacks are used.
#
RPC_URL_MAINNET_PUBLIC=""
RPC_URL_MAINNET_PRIVATE=""
RPC_URL_MAINNET="https://mainnet.infura.io/v3/KEY"
RPC_URL_BASE_PUBLIC=""
RPC_URL_BASE_PRIVATE=""
RPC_URL_BASE=""
RPC_URL_ARBITRUM_PUBLIC=""
RPC_URL_ARBITRUM_PRIVATE=""
RPC_URL_ARBITRUM=""
RPC_URL_POLYGON_PUBLIC=""
RPC_URL_POLYGON_PRIVATE=""
RPC_URL_POLYGON=""

#
# Misc app secrets
#
NEXTAUTH_SECRET="set-a-random-string"

#
# Price conversion (optional)
#
COINGECKO_API_KEY=""

#
# Contact form (Telegram)
#
TELEGRAM_BOT=""
TELEGRAM_RECIPIENT_USERID=""
# Optional: comma-separated list of IPs to block from the contact form
IP_TO_BLOCK=""
